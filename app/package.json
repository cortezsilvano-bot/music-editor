{
  "name": "music-editor",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "lint": "eslint src electron --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win",
    "desktop:dir": "npm run build && electron-builder --win --dir",
    "test:desktop": "npm run build && node scripts/desktop-smoke.mjs",
    "test:jobs": "npm run build && node scripts/job-lifecycle.mjs",
    "benchmark:library": "npm run build && node scripts/library-benchmark.mjs",
    "verify": "npm run lint && npm test && npm run build && node scripts/desktop-smoke.mjs && node scripts/job-lifecycle.mjs && node scripts/catalog-smoke.mjs",
    "test:stems": "npm run build && node scripts/stems-smoke.mjs",
    "test:server": "python -m unittest discover -s ../server -p test_*.py -v",
    "verify:stems": "npm run verify && npm run test:server && node scripts/stems-smoke.mjs",
    "test:catalog": "npm run build && node scripts/catalog-smoke.mjs",
    "benchmark:catalog": "npm run build && node scripts/catalog-benchmark.mjs"
  },
  "dependencies": {
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "@tanstack/react-virtual": "^3.11.2",
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2",
    "music-metadata": "^11.15.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "electron@44.4.3": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "electron/main.cjs",
  "description": "Local-first music analysis and DJ preparation",
  "author": {
    "name": "Music Editor"
  },
  "build": {
    "appId": "com.musiceditor.app",
    "productName": "Music Editor",
    "copyright": "Copyright (c) 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/.venv",
          "!**/.venv/**",
          "!**/.venv*/**",
          "!**/venv",
          "!**/venv/**",
          "!**/jobs",
          "!**/jobs/**",
          "!**/.pytest_cache",
          "!**/.pytest_cache/**",
          "!**/checkpoints",
          "!**/checkpoints/**",
          "!**/weights",
          "!**/weights/**",
          "!**/.cache",
          "!**/.cache/**",
          "!**/*.pyc",
          "!**/*.pth",
          "!**/*.ckpt",
          "!**/*.pt",
          "!**/*.bin"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MusicEditor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Editor",
      "uninstallDisplayName": "Music Editor ${version}"
    },
    "forceCodeSigning": false
  }
}
