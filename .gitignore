# Secrets — never commit. .env holds a live API key.
.env
.env.*
!.env.example

# Audio. The user's own tracks; large and not ours to publish.
demo/
tabla/
*.wav
*.mp3
*.flac
*.aiff
*.m4a

# Dependencies and build output — all regenerable.
node_modules/
app/dist/
app/release/
app/bench/fixtures/
server/.venv*/
__pycache__/
*.pyc

# The original Google AI Studio export at the project root: a compiled bundle
# with no source. Anchored with a leading slash - unanchored, these patterns
# also matched app/index.html (the app's entry page) and the embedded copy in
# app/public/studio, which silently left both out of the repository.
/assets/
/index.html

# Stem separation output and local caches.
server/jobs/
.music-editor-backups/

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Tiny synthetic test tones (sine waves, a few KB) - not music, and needed by CI.
!app/electron/fixtures/
!app/electron/fixtures/*

# Unrelated to the music editor
_luxe-label-studio-fixed.html
